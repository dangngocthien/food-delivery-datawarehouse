# Copy file này thành .env (không push .env thật lên Git) rồi chỉnh nếu cần.

# Nếu chạy spark-submit BÊN TRONG container spark-master (khuyến nghị — cùng docker network):
MINIO_ENDPOINT=http://minio:9000
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# Nếu chạy Spark trực tiếp từ máy host (ngoài container), đổi lại thành:
# MINIO_ENDPOINT=http://localhost:9000
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092

MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=food-delivery-lake
KAFKA_TOPIC=order-events
